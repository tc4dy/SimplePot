# This is only a demo for your config.
# SimplePot Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# ALERTING CONFIGURATION
# ============================================

# Slack Webhook URL (for alerts)
# Create a Slack app and Incoming Webhook
SLACK_WEBHOOK=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklmNOPqrstUVwxyz

# Telegram Chat ID (can be user or group ID)
TELEGRAM_CHAT_ID=-123456789

# Generic Webhook URL (for custom integration)
WEBHOOK_URL=https://your-webhook-endpoint.com/api/alerts

# ============================================
# HONEYPOT BEHAVIOR (override defaults)
# ============================================

# Maximum connections per IP (default: 50)
MAX_CONNECTIONS_PER_IP=50

# Auto-ban threshold (threat score) (default: 70)
ALERT_THRESHOLD=70

# Session timeout in seconds (default: 300)
SESSION_TIMEOUT=300

# Max session duration (default: 600)
MAX_SESSION_DURATION=600

# Enable active defense (iptables) (default: true)
ACTIVE_DEFENSE_ENABLED=true

# Enable threat intelligence (default: true)
THREAT_INTEL_ENABLED=true

# Data retention days (default: 90)
DATA_RETENTION_DAYS=90

# ============================================
# ADVANCED (modify CONFIG dict in code for full control)
# ============================================

# Custom hostname (fake)
FAKE_HOSTNAME=prod-server-01

# Custom SSH banner
FAKE_OS=Ubuntu 20.04.6 LTS
